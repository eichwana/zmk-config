#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define LWR 1
#define RSE 2
#define ADJ 3

/ {


    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Base
        default_layer {
            bindings = <
// ╭─────────┬─────────┬─────────┬─────────┬─────────┬─────────╮                 ╭─────────┬─────────┬─────────┬─────────┬─────────┬─────────╮
    &kp GRAVE  &kp N1    &kp N2    &kp N3    &kp N4    &kp N5                       &kp N6    &kp N7    &kp N8    &kp N9    &kp N0   &kp MINUS
// ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤                 ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
    &kp TAB    &kp Q     &kp W     &kp E     &kp R     &kp T                        &kp Y     &kp U     &kp I     &kp O     &kp P    &kp NUHS
// ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤                 ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
    &kp LCTRL  &kp A     &kp S     &kp D     &kp F     &kp G                        &kp H     &kp J     &kp K     &kp L    &kp SEMI   &kp SQT
// ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤                 ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
    &kp LALT   &kp Z     &kp X     &kp C     &kp V     &kp B                        &kp N     &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp NUBS
// ├─────────┼─────────┼─────────┼─────────╮                                                         ╭─────────┼─────────┼─────────┼─────────┤
    &aim AIM_TOG &kp C_PP &kp BSPC  &mo 1                                                             &kp C_PREV &kp C_NEXT &kp LBKT  &kp RBKT
// ╰─────────┴─────────┴─────────┴─────────╯                                                         ╰─────────┴─────────┴─────────┴─────────╯
//                                         ╭─────────┬─────────╮ ╭─────────┬─────────╮
                                             &kp LGUI  &kp DEL      &kp F5    &kp F4
//                                         ├─────────┼─────────┤ ├─────────┼─────────┤
                                             &kp SPACE &kp LSHFT  &kp RET   &kp PG_DN
//                                         ├─────────┼─────────┤ ├─────────┼─────────┤
                                             &kp RET   &kp ESC    &kp PG_UP &kp SPACE
//                                         ╰─────────┴─────────╯ ╰─────────┴─────────╯
            >;
        };

        // Layer 1: Functions
                fn_layer {
            bindings = <
// ╭─────────┬─────────┬─────────┬─────────┬─────────┬─────────╮                 ╭─────────┬─────────┬─────────┬─────────┬─────────┬─────────╮
    &trans     &kp F1    &kp F2    &kp F3    &kp F4    &kp F5                       &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11
// ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤                 ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
    &trans     &trans    &kp UP    &trans    &trans   &out OUT_TOG                  &trans    &trans    &trans    &trans    &trans    &kp F12
// ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤                 ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
    &trans     &kp LEFT  &kp DOWN  &kp RIGHT &trans   &bt BT_SEL 0                  &trans    &trans    &trans    &trans    &trans    &trans
// ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤                 ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
    &trans     &trans    &trans    &trans    &trans   &bt BT_SEL 1                  &trans    &trans    &trans    &trans    &trans    &trans
// ├─────────┼─────────┼─────────┼─────────╮                                                         ╭─────────┼─────────┼─────────┼─────────┤
    &trans     &trans    &trans    &trans                                                              &trans    &trans    &trans    &trans
// ╰─────────┴─────────┴─────────┴─────────╯                                                         ╰─────────┴─────────┴─────────┴─────────╯
//                                         ╭─────────┬─────────╮ ╭─────────┬─────────╮
                                             &trans    &trans       &trans    &trans
//                                         ├─────────┼─────────┤ ├─────────┼─────────┤
                                             &bt BT_CLR  &trans    &kp EQUAL  &kp END
//                                         ├─────────┼─────────┤ ├─────────┼─────────┤
                                             &trans    &trans      &kp HOME   &trans
//                                         ╰─────────┴─────────╯ ╰─────────┴─────────╯
            >;
        };
};};
